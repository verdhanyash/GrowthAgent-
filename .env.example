# ── GrowthAgent environment ────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit the real .env.

# Provider selection is EXPLICIT, never presence-based (boot fails closed on
# inconsistency). MOCK requires keys to be ABSENT; TEST_MODE requires both.
RAZORPAY_PROVIDER=MOCK
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# Webhook HMAC secret (MockProvider signs with this locally too — same verify path)
# RAZORPAY_WEBHOOK_SECRET=

# Claude — live calls; DEMO_STABLE_MODE=true switches LLM transports to recorded replay
ANTHROPIC_API_KEY=
DEMO_STABLE_MODE=false

# Postgres/Redis on non-standard host ports (docker-compose maps 15432/16379)
DATABASE_URL=postgres://growthagent_owner:growthagent_owner@localhost:15432/growthagent
REDIS_URL=redis://localhost:16379/0

# Admin-plane guard (loopback-bound, constant-time compared)
ADMIN_TOKEN=change-me-local-only

# HMAC secret for single-use human-approval capability tokens (TB-4)
APPROVAL_TOKEN_SECRET=change-me-32-bytes-min

# Simulation clock: ISO timestamp anchoring synthetic "today" for seeds/expiry.
# Leave empty to pin SIM_NOW at seed time automatically (stored config value).
SIM_NOW=

# Fixed PRNG seed for reproducible sales history + deterministic row order
DEFAULT_SEED=meeras-cakes-v1

API_PORT=3000
LOG_LEVEL=info
